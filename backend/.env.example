PORT=8000
MONGODB_URI=your_mongodb_connection_string
DB_NAME=kavya
CORS_ORIGIN=http://localhost:5173

# --- Authentication ---
# The ONLY account that gets admin rights (Google or password login).
ADMIN_EMAIL=your.admin@gmail.com
# Long random string used to sign session tokens, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change_me_to_a_long_random_string
SESSION_TTL=7d
# New students may self-register only with this email domain.
ALLOWED_STUDENT_DOMAIN=thapar.edu

# Firebase project used for Google sign-in (Project settings > General > Project ID).
# Only needed to verify Google ID tokens. A service account key is optional.
FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# --- LinkedIn ---
# Fetching linkedin.com profile pages from the server is disabled by default (LinkedIn terms).
# Profile data comes from the user's own LinkedIn "Save to PDF" export.
LINKEDIN_URL_FETCH=false
